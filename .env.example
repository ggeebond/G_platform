# ============================================================
# Soul Lab —— 环境变量模板
#
# 用法：复制本文件为 .env 并填入真实值。.env 已被 .gitignore 忽略，
#      **永远不会进入仓库**；本文件（.env.example）只有占位符，可以安全提交。
#
# 关键原则：这些变量只在 **服务端进程** 使用。
#  浏览器 → 你的服务端(/api/*) → CodeBuddy Agent SDK → 模型
#  前端代码 / 前端打包产物里 **绝不能出现** API Key。
# ============================================================

# ---------- 1. CodeBuddy Agent SDK（必填，本地 + Vercel 都需） ----------
# 形如 ck_xxxxxxxx.xxxxxxxx
CODEBUDDY_API_KEY=your_api_key_here

# 以下均可选（本地登录或自建网关时用）
# CODEBUDDY_AUTH_TOKEN=
# CODEBUDDY_BASE_URL=
# CODEBUDDY_INTERNET_ENVIRONMENT=

# ---------- 2. 数据库后端 ----------
# 本地开发（默认）：留空即可，自动用 better-sqlite3 写入 ./data/chat.db
#
# Vercel 部署（Serverless 文件系统只读）：必须改用外部数据库。
# 推荐 Turso（libSQL 托管），二选一设置即可：
#   TURSO_URL + TURSO_AUTH_TOKEN   （推荐）
#   DATABASE_URL + DATABASE_AUTH_TOKEN
# 只要检测到 TURSO_URL 或 DATABASE_URL，就会自动切换到 libSQL 后端。
TURSO_URL=
TURSO_AUTH_TOKEN=
# DATABASE_URL=
# DATABASE_AUTH_TOKEN=

# ---------- 3. 数学沙箱执行器 ----------
# 本地开发默认用系统/项目 .venv 的 CPython（child_process，快）。
# Vercel 上无系统 Python，会自动探测 VERCEL 环境变量改用 Pyodide（Python→WASM，进程内运行）。
# 如需强制覆盖：child_process | pyodide
# MATH_EXECUTOR=pyodide

# ---------- 4. 服务器端口（仅本地 index.ts 监听用，Vercel 忽略） ----------
# PORT=3007
